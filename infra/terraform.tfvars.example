# AWS region for all resources (must match AWS CLI default region)
aws_region = "us-east-1"

# Environment name
environment = "dev"

# EC2 instance type (t4g family recommended for ARM/Graviton cost efficiency)
instance_type = "t4g.small"

# Root EBS volume size in GB
volume_size = 30

# Number of days to retain database backups in S3
backup_retention_days = 30

# Number of days before moving S3 data to Infrequent Access storage
data_lifecycle_days = 90
